<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <!-- Логотип Android -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="@dimen/logo_size"
        android:layout_height="@dimen/logo_size"
        android:src="@android:drawable/sym_def_app_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/margin_top_logo"/>

    <!-- Имя -->
    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/my_name"
        android:textSize="@dimen/text_size_name"
        android:textColor="@color/primary_dark"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/margin_top_name"/>

    <!-- Группа -->
    <TextView
        android:id="@+id/group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/my_group"
        android:textSize="@dimen/text_size_group"
        android:textColor="@color/primary"
        app:layout_constraintTop_toBottomOf="@+id/name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/margin_top_group"/>

    <!-- Email -->
    <LinearLayout
        android:id="@+id/email_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/margin_top_contacts"
        app:layout_constraintTop_toBottomOf="@+id/group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:src="@android:drawable/ic_dialog_email"
            android:tint="@color/icon_tint"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_email"
            android:textSize="@dimen/text_size_contact"
            android:textColor="@color/primary_light"
            android:layout_marginStart="@dimen/margin_icon_text"/>
    </LinearLayout>

    <!-- Телефон -->
    <LinearLayout
        android:id="@+id/phone_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/margin_between_contacts"
        app:layout_constraintTop_toBottomOf="@+id/email_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:src="@android:drawable/ic_menu_call"
            android:tint="@color/icon_tint"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_phone"
            android:textSize="@dimen/text_size_contact"
            android:textColor="@color/primary_light"
            android:layout_marginStart="@dimen/margin_icon_text"/>
    </LinearLayout>

    <!-- Telegram -->
    <LinearLayout
        android:id="@+id/telegram_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/margin_between_contacts"
        app:layout_constraintTop_toBottomOf="@+id/phone_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:src="@android:drawable/ic_menu_share"
            android:tint="@color/icon_tint"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_telegram"
            android:textSize="@dimen/text_size_contact"
            android:textColor="@color/primary_light"
            android:layout_marginStart="@dimen/margin_icon_text"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>